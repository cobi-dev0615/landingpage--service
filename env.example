# Brevo API Configuration
BREVO_API_KEY=your_brevo_api_key_here

# Brevo Template ID (get this from your Brevo dashboard)
# Go to Campaigns > Email Templates, find your template and copy the ID
BREVO_TEMPLATE_ID=0

# Server Configuration
PORT=3001
NODE_ENV=development

# Email Configuration
FROM_EMAIL=contato@bethmirage.com
FROM_NAME=Beth Mirage
REPLY_TO_EMAIL=contato@bethmirage.com

# E-book PDF Path (relative to server directory)
# Default location: ./media/ebook.pdf
# EBOOK_PDF_PATH=./media/ebook.pdf

# Backend URL (for PDF download links in emails)
BACKEND_URL=https://landingpage-service.vercel.app
# Alternative: API_URL (will be used if BACKEND_URL is not set)
# API_URL=https://landingpage-service.vercel.app

# Frontend Domain (for platform links)
DOMAIN=https://www.bethmirage.com
FRONTEND_URL=http://localhost:3000

# Platform Link (optional - link to your platform/software)
PLATFORM_LINK=https://www.bethmirage.com
